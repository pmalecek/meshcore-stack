# Vzor nastavení – instalace (meshcore-stack install) vytvoří .env sama. Ruční instalace: zkopíruj jako .env a vyplň.

# Verze klienta a serveru: auto = doporučená verze pro tuto verzi stacku, jinak tag nebo větev na GitHubu
KLIENT_REF=auto
SERVER_REF=auto

# Připojení companionu: tcp | usb | ble. COMPOSE_FILE nastavuje meshcore-stack sám
# (docker-compose.yml:compose.<transport>.yml[:compose.api.yml])
COMPANION_TRANSPORT=tcp
COMPOSE_FILE=docker-compose.yml:compose.tcp.yml
COMPANION_HOST=192.168.1.160
COMPANION_PORT=5000
# USB:
# COMPANION_DEVICE=/dev/ttyUSB0
# COMPANION_DEVICE_GID=20
# Bluetooth:
# COMPANION_BLE_ADDRESS=
# COMPANION_BLE_PIN=

# Web klienta
WEB_PORT=8080
TZ=Europe/Prague
# Jméno companionu, jak ho vidí analyzer (nepovinné, zpřesní kontrolu heard)
NODE_NAME=

# Hesla databáze (jen písmena a číslice) – vygeneruj např.: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
DB_ROOT_PASSWORD=
KLIENT_DB_PASSWORD=
SERVER_DB_PASSWORD=

# API token klienta pro server – instalace ho vytvoří sama. Ručně:
#   docker compose exec meshcore-server meshcore-server token create meshcore-klient --scope admin
MC_SERVER_TOKEN=

ADMIN_USER=admin

# API serveru pro další aplikace (meshcore-stack api on [port] | off)
API_ENABLED=0
SERVER_API_PORT=8081
